# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for lookups. See https://ai.google.dev/gemini-api/docs/models
#   gemini-3.5-flash       balanced, the default
#   gemini-3.8-flash       smarter, costs more
#   gemini-3.5-flash-lite  cheapest, fine for plain definitions
# Note: gemini-2.5-* is legacy and closed to new projects.
GEMINI_MODEL=gemini-3.5-flash

PORT=3210
