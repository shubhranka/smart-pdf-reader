# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for lookups. See https://ai.google.dev/gemini-api/docs/models
#   gemini-3.5-flash       balanced, the default
#   gemini-3.8-flash       smarter, costs more
#   gemini-3.5-flash-lite  cheapest, fine for plain definitions
# Note: gemini-2.5-* is legacy and closed to new projects.
GEMINI_MODEL=gemini-3.5-flash

# --- Other providers (optional) ---
# Which model answers lookups and recaps: gemini, mistral, groq, openrouter or nvidia.
# Leave it unset and the first provider above/below with a key wins.
# LLM_PROVIDER=gemini

# Mistral — key at https://console.mistral.ai/api-keys
#   mistral-small-latest   fast and cheap, the default
#   mistral-medium-latest  smarter, costs more
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Groq — key at https://console.groq.com/keys, models at https://console.groq.com/docs/models
#   openai/gpt-oss-120b   the default; strict JSON and real reasoning
#   openai/gpt-oss-20b    faster and cheaper
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter — one key for hundreds of models. Key at https://openrouter.ai/settings/keys
# Pick any model that supports structured outputs:
#   https://openrouter.ai/models?supported_parameters=structured_outputs
#   openai/gpt-oss-120b      the default; strict JSON and real reasoning
#   google/gemini-3.5-flash-lite, deepseek/deepseek-v4-flash, anthropic/claude-haiku-4.5 ...
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b

# NVIDIA NIM — hosted at build.nvidia.com (key nvapi-... at https://build.nvidia.com/settings/api-keys),
# or your own NIM container: set NVIDIA_API_BASE=http://localhost:8000/v1
#   deepseek-ai/deepseek-v4.1-flash   the default
# NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

PORT=3210

# Recap sizing. Defaults are fine; these are here for when they are not.
#   RECAP_BUDGET_CHARS   above this, a recap is summarised in chunks (default 60000, ~26 pages)
#   RECAP_CHUNK_CHARS    target size of one chunk (default 48000, ~20 pages)
#   RECAP_MAX_CHUNKS     guard against unusually dense pages (default 24)
#   RECAP_MAX_PAGES      largest range a single recap will accept (default 300)
#   RECAP_CONCURRENCY    chunk calls in flight at once (default 3)
